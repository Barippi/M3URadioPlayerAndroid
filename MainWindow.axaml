<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="M3URadioPlayer.Android.MainWindow"
             Background="#1E1E1E">
  <Grid>
    <!-- メイン再生画面 (MainActivity側でシステムバー余白が物理的に確保されます) -->
    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="16,12,16,16">
      <!-- ヘッダー（タイトル・ステータス ＋ Aboutボタン） -->
      <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
        <StackPanel Grid.Column="0">
          <TextBlock Name="StatusText" Text="未再生" FontSize="20" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
          <TextBlock Name="TitleText" Text="タイトル: ---" FontSize="14" Foreground="#4CC2FF" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Column="1" Content="ℹ️ About" Click="OnAboutOpenClicked" 
                VerticalAlignment="Top" Background="#2D2D30" Foreground="White" FontSize="12" Padding="8,4" />
      </Grid>

      <!-- プレイリスト選択 -->
      <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
        <ComboBox Name="PlaylistCombo" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0,0,8,0" />
        <Button Name="ReloadButton" Grid.Column="1" Content="再読込" Click="OnReloadClicked" />
      </Grid>

      <!-- 局リスト -->
      <ListBox Name="StationList" Grid.Row="2" Background="#252525" Margin="0,0,0,16">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}" Padding="8,6" Foreground="White" FontSize="15"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- 再生・停止ボタン -->
      <Grid Grid.Row="3" ColumnDefinitions="*, *">
        <Button Name="PlayButton" Grid.Column="0" Content="再生" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,6,0" Height="48" Click="OnPlayClicked" />
        <Button Name="StopButton" Grid.Column="1" Content="停止" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="6,0,0,0" Height="48" Click="OnStopClicked" />
      </Grid>
    </Grid>

    <!-- About モーダルオーバーレイ（最前面ポップアップ） -->
    <Grid Name="AboutOverlay" Background="#B0000000" IsVisible="False">
      <Border Background="#2B2B2B" CornerRadius="12" Margin="20" Padding="18" 
              VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxHeight="520">
        <Grid RowDefinitions="Auto, *, Auto">
          <!-- タイトル -->
          <TextBlock Grid.Row="0" Text="M3U Radio Player" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10" />

          <!-- スクロールライセンス表示領域 -->
          <ScrollViewer Grid.Row="1" Margin="0,0,0,14">
            <StackPanel Spacing="10">
              <TextBlock Text="Version 1.0.0&#x0a;Copyright (c) 2026 Barippi" FontSize="13" Foreground="#CCCCCC" />

              <Border Height="1" Background="#444444" Margin="0,4" />
              <TextBlock Text="Third-Party Licenses &amp; Credits:" FontWeight="Bold" FontSize="13" Foreground="White" />

              <!-- BASS クレジット -->
              <StackPanel Spacing="2">
                <TextBlock Text="• BASS Audio Library &amp; BASS FLAC add-on" FontWeight="SemiBold" FontSize="12" Foreground="#4CC2FF" />
                <TextBlock Text="  Copyright (c) 1999-2026 Un4seen Developments Ltd.&#x0a;  Used under non-commercial freeware license.&#x0a;  https://www.un4seen.com/" 
                           FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" />
              </StackPanel>

              <!-- Avalonia UI クレジット -->
              <StackPanel Spacing="2">
                <TextBlock Text="• Avalonia UI" FontWeight="SemiBold" FontSize="12" Foreground="#4CC2FF" />
                <TextBlock Text="  Copyright (c) .NET Foundation and Contributors&#x0a;  Licensed under the MIT License&#x0a;  https://github.com/AvaloniaUI/Avalonia" 
                           FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" />
              </StackPanel>

              <!-- ManagedBass クレジット -->
              <StackPanel Spacing="2">
                <TextBlock Text="• ManagedBass" FontWeight="SemiBold" FontSize="12" Foreground="#4CC2FF" />
                <TextBlock Text="  Copyright (c) Mathew Sachin&#x0a;  Licensed under the MIT License&#x0a;  https://github.com/Japyna/ManagedBass" 
                           FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- 閉じるボタン -->
          <Button Grid.Row="2" Content="閉じる" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Height="40" Background="#3A3A3D" Foreground="White" Click="OnAboutCloseClicked" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
